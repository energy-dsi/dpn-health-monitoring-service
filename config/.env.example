# ============================================================================
# DPN Observability – Alert Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.
# ============================================================================

# ============================================================================
# NGINX AUTH PROXY — Single admin login for all observability UIs
# ============================================================================
# The file config/nginx/.htpasswd contains the bcrypt-hashed password.
# It is gitignored — generate it locally before starting the stack:
#
#   Using htpasswd (apache2-utils / httpd-tools):
#     htpasswd -nbB admin <your-password>
#     → paste the output line into config/nginx/.htpasswd
#
#   Using Python (if htpasswd is not installed):
#     python3 -c "import bcrypt; print('admin:' + bcrypt.hashpw(b'<your-password>', bcrypt.gensalt(12)).decode())"
#     → paste the output line into config/nginx/.htpasswd
#
# Default shipped credential (CHANGE THIS):
#   username: admin
#   password: admin123
# ============================================================================

# Email address that receives failure alerts from OpenSearch
# To send to multiple addresses, the monitor can only target one destination —
# add additional recipients by duplicating the ALERT_EMAIL line is not supported;
# instead add them comma-separated and update the script, or use a mailing list.
ALERT_EMAIL=your-team@example.com

# SMTP settings for OpenSearch alerting destination
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_FROM=opensearch-alerts@example.com

# Optional — leave blank if SMTP relay requires no authentication
SMTP_USER=
SMTP_PASS=

# Comma-separated list of log severity levels that trigger an alert.
# Allowed values: TRACE, DEBUG, INFO, WARN, ERROR, FATAL
# Examples:
#   ERROR only:            ALERT_SEVERITIES=ERROR
#   Errors and warnings:   ALERT_SEVERITIES=ERROR,WARN
#   All failures:          ALERT_SEVERITIES=ERROR,WARN,FATAL
ALERT_SEVERITIES=ERROR,FATAL
